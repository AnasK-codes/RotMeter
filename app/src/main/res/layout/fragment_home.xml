<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/rot_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.RotMeter.Headline"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_subtitle"
            android:textAppearance="@style/TextAppearance.RotMeter.Secondary" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/player_card"
            style="@style/Widget.RotMeter.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/avatar_level"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_player_avatar"
                        android:gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:textSize="22sp"
                        android:textColor="@color/rot_accent_text"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="22sp"
                        android:autoSizeStepGranularity="1sp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/player_level"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.RotMeter.Body"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/player_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/player_doomscroller"
                            android:textAppearance="@style/TextAppearance.RotMeter.Secondary" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/xp_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:max="200"
                            app:indicatorColor="@color/rot_neon_purple"
                            app:trackColor="@color/rot_surface_variant"
                            app:trackThickness="6dp"
                            app:trackCornerRadius="3dp" />
                        <TextView
                            android:id="@+id/xp_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/TextAppearance.RotMeter.Secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/streak_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:textColor="@color/rot_text_primary"
                        app:chipBackgroundColor="@color/rot_surface_variant"
                        app:chipStrokeColor="@color/rot_stroke"
                        app:chipStrokeWidth="1dp" />
                    <TextView
                        android:id="@+id/best_streak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:textAppearance="@style/TextAppearance.RotMeter.Secondary"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            style="@style/Widget.RotMeter.Card"
            android:id="@+id/rot_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rot_score_title"
                    android:textAppearance="@style/TextAppearance.RotMeter.Label" />
                <com.rotmeter.app.views.RotRingView
                    android:id="@+id/rot_ring"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="8dp" />
                <TextView
                    android:id="@+id/rot_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/initial_score"
                    android:textColor="@color/rot_fresh"
                    android:textSize="72sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/level_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/level_fresh"
                    android:textColor="@color/rot_fresh"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/rot_meter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:max="300"
                    android:progress="0"
                    app:indicatorColor="@color/rot_fresh"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="12dp"
                    app:trackColor="@color/rot_surface_variant"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/roast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/roast_fresh"
                    android:textAppearance="@style/TextAppearance.RotMeter.Body"
                    android:textColor="@color/rot_text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RotMeter.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:id="@+id/credits_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/productive_credits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RotMeter.Body"
                    android:textColor="@color/rot_cyan_text"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/home_empty_state"
            android:textAppearance="@style/TextAppearance.RotMeter.Secondary"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sync_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/sync_now"
            style="@style/Widget.RotMeter.Button.Pill" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/load_demo"
            style="@style/Widget.RotMeter.Button.Pill.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/load_demo_data" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/quests_card"
            style="@style/Widget.RotMeter.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_quests"
                    android:textAppearance="@style/TextAppearance.RotMeter.Label" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quest_productive_card"
                    style="@style/Widget.RotMeter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:id="@+id/quest_productive_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="10dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_quest" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/quest_productive"
                                android:textAppearance="@style/TextAppearance.RotMeter.Body"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/quest_productive_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/TextAppearance.RotMeter.Secondary"
                            android:textSize="12sp" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/quest_productive_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            app:indicatorColor="@color/rot_neon_purple"
                            app:trackColor="@color/rot_surface_variant"
                            app:trackThickness="4dp"
                            app:trackCornerRadius="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quest_limit_card"
                    style="@style/Widget.RotMeter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:id="@+id/quest_limit_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="10dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_quest" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/quest_limit"
                                android:textAppearance="@style/TextAppearance.RotMeter.Body"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/quest_limit_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/TextAppearance.RotMeter.Secondary"
                            android:textSize="12sp" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/quest_limit_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            app:indicatorColor="@color/rot_neon_purple"
                            app:trackColor="@color/rot_surface_variant"
                            app:trackThickness="4dp"
                            app:trackCornerRadius="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quest_roasts_card"
                    style="@style/Widget.RotMeter.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:id="@+id/quest_roasts_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="10dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_quest" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/quest_zero_roasts"
                                android:textAppearance="@style/TextAppearance.RotMeter.Body"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/quest_roasts_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAppearance="@style/TextAppearance.RotMeter.Secondary"
                            android:textSize="12sp" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/quest_roasts_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:max="100"
                            app:indicatorColor="@color/rot_neon_purple"
                            app:trackColor="@color/rot_surface_variant"
                            app:trackThickness="4dp"
                            app:trackCornerRadius="2dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/badges_card"
            style="@style/Widget.RotMeter.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/badges_title"
                    android:textAppearance="@style/TextAppearance.RotMeter.Label" />
                <androidx.recyclerview.widget.RecyclerView
            android:layoutAnimation="@anim/list_entry"
                    android:id="@+id/badges_list"
                    android:layout_width="match_parent"
                    android:layout_height="288dp"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/top_rot_apps"
            android:textAppearance="@style/TextAppearance.RotMeter.Label" />
        <androidx.recyclerview.widget.RecyclerView
            android:layoutAnimation="@anim/list_entry"
            android:id="@+id/top_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />
        <TextView
            android:id="@+id/no_rot_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_rot_apps"
            android:textAppearance="@style/TextAppearance.RotMeter.Secondary"
            android:visibility="gone" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RotMeter.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:id="@+id/week_card">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/week_comparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RotMeter.Body"
                    android:textColor="@color/rot_text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:id="@+id/error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/home_load_error"
            android:textAppearance="@style/TextAppearance.RotMeter.Body"
            android:textColor="?attr/colorError"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
