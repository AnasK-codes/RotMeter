<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.RotMeter.Card.Item" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/app_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="12dp" android:textAppearance="@style/TextAppearance.RotMeter.Body" android:textStyle="bold" />
            <TextView android:id="@+id/app_minutes" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RotMeter.Body" android:textStyle="bold" android:textColor="@color/rot_cyan_text" />
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/usage_share"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:visibility="gone"
            android:max="100" app:trackThickness="5dp" app:trackCornerRadius="3dp"
            app:trackColor="@color/rot_surface_variant" app:indicatorColor="@color/rot_neon_purple" />
        <TextView android:id="@+id/share_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:visibility="gone" android:textAppearance="@style/TextAppearance.RotMeter.Secondary" android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
