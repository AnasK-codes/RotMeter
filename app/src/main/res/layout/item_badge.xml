<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.RotMeter.Card" android:layout_width="132dp" android:layout_height="132dp"
    android:layout_marginEnd="12dp" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">
        <ImageView
            android:id="@+id/badge_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/badge_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.RotMeter.Body"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/badge_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.RotMeter.Secondary"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
