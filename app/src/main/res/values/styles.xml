<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.RotMeter.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/rot_surface</item>
        <item name="strokeColor">@color/rot_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Widget.RotMeter.Card.Item" parent="Widget.RotMeter.Card">
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="TextAppearance.RotMeter.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/rot_text_primary</item>
    </style>
    <style name="TextAppearance.RotMeter.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/rot_text_secondary</item>
    </style>
    <style name="TextAppearance.RotMeter.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/rot_text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.RotMeter.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/rot_text_secondary</item>
    </style>
    <style name="Widget.RotMeter.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">1000dp</item>
        <item name="backgroundTint">@color/button_fill</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="Widget.RotMeter.Button.Pill.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">1000dp</item>
        <item name="backgroundTint">@color/rot_transparent</item>
        <item name="strokeColor">@color/rot_neon_purple</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/button_outline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="Widget.RotMeter.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_navigation</item>
        <item name="android:elevation">0dp</item>
        <item name="itemIconTint">@color/navigation_item_tint</item>
        <item name="itemTextColor">@color/navigation_text_tint</item>
        <item name="itemRippleColor">@color/rot_nav_active</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.RotMeter.Navigation.ActiveIndicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.RotMeter.Navigation</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.RotMeter.Navigation</item>
    </style>
    <style name="TextAppearance.RotMeter.Navigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.RotMeter.Navigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="android:color">@color/rot_nav_active</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RotMeter.Pill</item>
    </style>
    <style name="ShapeAppearance.RotMeter.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Widget.RotMeter.InfoPill" parent="">
        <item name="android:background">@drawable/bg_info_pill</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/rot_text_secondary</item>
    </style>
    <style name="ShapeAppearance.RotMeter.ChatBubble" parent="">
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
    </style>
</resources>
